# WordPress Backend URL (sin trailing slash)
WORDPRESS_URL=https://atrpoker.com
WORDPRESS_HOSTNAME=atrpoker.com

# NextAuth — genera un secreto con: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Roles de WordPress que tienen acceso al streaming
# (separados por coma, en minúsculas tal como los define WP)
STREAMING_ROLES=subscriber,contributor,author,editor,administrator

# Bunny Stream — Token Authentication keys (una por Library ID)
# Encontrás la key en: Bunny Panel → Stream → [Library] → Security → Token Authentication Key
# Solo necesario si Token Authentication está activado en esa librería
# BUNNY_TOKEN_KEY_510800=tu-token-key-aqui
# BUNNY_TOKEN_KEY_581821=tu-token-key-aqui

# Opcional: WordPress Application Password para operaciones autenticadas
# WP_APP_USER=tu_usuario
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Resend — envío de emails (tickets de soporte, etc.)
# Obtené tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here
# Dirección que recibe los tickets de soporte
SUPPORT_EMAIL=soporte@atrpoker.com
